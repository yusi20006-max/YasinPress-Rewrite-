YASINPRESS_ENV=production
YASINPRESS_DATABASE=yasinpress.db
YASINPRESS_LOG_LEVEL=INFO
YASINPRESS_SECRET_KEY=change-me

# Feed input
# Comma-separated RSS/Atom feeds. Keep only sources that are enabled for the deployment.
YASINPRESS_FEEDS=https://feeds.bbci.co.uk/persian/rss.xml,https://newsrss.bbc.co.uk/rss/newsonline_world_edition/front_page/rss.xml,https://www.irna.ir/rss,https://www.isna.ir/rss,https://www.mehrnews.com/rss,https://www.ilna.ir/rss,https://www.khabaronline.ir/rss,https://www.tasnimnews.ir/fa/rss/feed/0/0/4,https://www.donya-e-eqtesad.com/rss
YASINPRESS_FEED_SOURCE=rss

# Independent web outputs
YASINPRESS_PWA_OUTPUT=data/pwa/feed.json
YASINPRESS_PWA_TITLE=YasinPress
YASINPRESS_PWA_HOME_URL=
YASINPRESS_PWA_FEED_URL=
YASINPRESS_RSS_OUTPUT=data/rss/feed.xml
YASINPRESS_RSS_TITLE=YasinPress
YASINPRESS_RSS_LINK=
YASINPRESS_RSS_FEED_URL=
YASINPRESS_MAX_FEED_ITEMS=100

# Runtime
YASINPRESS_SCHEDULER_INTERVAL=600
YASINPRESS_WORKER_INTERVAL=1
YASINPRESS_MAX_JOB_ATTEMPTS=3
YASINPRESS_REQUEST_TIMEOUT=20
YASINPRESS_MAX_ARTICLE_AGE_HOURS=12
YASINPRESS_MAX_PUBLICATIONS_PER_HOUR=10

# AI (canonical Yasin-AI integration)
YASINPRESS_AI_ENABLED=false
YASINPRESS_AI_PROVIDER=yasin-ai
YASINPRESS_AI_MODEL=
YASINPRESS_AI_TIMEOUT=30
# Yasin-AI owns provider credentials/configuration. Do not put provider SDK keys in YasinPress.

# Legacy OpenAI-compatible adapter (only when YASINPRESS_AI_PROVIDER=openai-compatible)
YASINPRESS_AI_BASE_URL=https://api.openai.com/v1
YASINPRESS_AI_API_KEY_ENV=OPENAI_API_KEY

# Eitaa publishing (keep secrets only in the local environment)
YASINPRESS_EITAA_TOKEN=
YASINPRESS_EITAA_CHANNEL=
YASINPRESS_EITAA_API_BASE=https://eitaayar.ir/api
